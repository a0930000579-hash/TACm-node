# ============================================================
# TAC Ai Smart Chain — Git 忽略規則（防私鑰/鏈資料洩漏）
# 公開 repo 前必須確認以下類別皆未被追蹤！
# ============================================================

# 節點私鑰與身份（絕不可公開）
node_key.json
*.node_key
validator_key*
node_identity*

# 鏈資料與資料庫（體積大且含敏感狀態）
data/
data_*
*.db
*.sqlite
*.sqlite3
tacnet/

# 環境變數與 API 金鑰
.env
.env.*
*.pem
*.key
secrets/

# 編譯產物與暫存
tacweb
tacnode
nodeweb
tacctl
*.exe
*.log
*.out
tmp/
*.zip

# OS / 編輯器
.DS_Store
Thumbs.db
.idea/
.vscode/
